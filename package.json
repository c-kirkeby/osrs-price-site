{
  "name": "osrs-price-site",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "dev": "vp dev",
    "build": "wrangler types --check && vp build",
    "preview": "pnpm run build && wrangler dev",
    "deps": "vpx taze@latest -Ilwr --maturity-period 3",
    "deps:major": "vpx taze@latest major -Ilwr --maturity-period 3",
    "test": "npm run test:integration && npm run test:unit",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --plugin-search-dir . --check . && vp lint .",
    "format": "vp fmt --plugin-search-dir . .",
    "test:integration": "playwright test",
    "test:unit": "vp test",
    "gen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.139.0"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/query-db-collection": "^1.2.15",
    "@tanstack/svelte-db": "^0.4.1",
    "@tanstack/svelte-table": "^9.2.4",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "cmdk-sv": "^0.0.19",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "flexsearch": "^0.8.212",
    "layerchart": "^2.5.0",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.1",
    "runed": "^0.37.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "valibot": "^1.5.0"
  }
}
